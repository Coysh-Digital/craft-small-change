{% extends 'small-change/emails/_layout' %}

{% block body %}
    <h1 style="font-size:20px;margin:0 0 12px;">{{ content.heading ?: (order.hasDonation ? 'Your recurring donation has ended' : 'Your subscription has ended') }}</h1>
    {% if content.message %}{{ content.message }}{% else %}
    <p>Your {{ context.interval == 'year' ? 'yearly' : 'monthly' }} {{ order.hasDonation ? 'donation' : 'subscription' }} to {{ settings.charityName ?: siteName }} has been cancelled and nothing more will be taken.</p>
    {% if order.hasDonation %}<p>Thank you for everything you've given.</p>{% endif %}
    {% endif %}
{% endblock %}
