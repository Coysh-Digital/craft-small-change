{% extends 'small-change/emails/_layout' %}

{% block body %}
    <h1 style="font-size:20px;margin:0 0 12px;">{{ content.heading ?: 'A recurring donation was cancelled' }}</h1>
    {% if content.message %}{{ content.message }}{% else %}
    <p>The {{ context.interval == 'year' ? 'yearly' : 'monthly' }} donation of {{ craft.smallChange.formatMoney(context.amount|default(order.total), order.currency) }} from {{ order.email }} has ended.</p>
    {% endif %}
    <p><a href="{{ cpUrl('small-change/orders/' ~ order.id) }}">View the original order</a></p>
{% endblock %}
