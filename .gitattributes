# Keep the Composer dist archive to what a site actually runs.
#
# These all stay in the repository - clone it and the docs and tooling are
# there. They are just not worth downloading into every site's vendor/
# directory on every install.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/codeception.yml    export-ignore
/docs               export-ignore
/ecs.php            export-ignore
/phpstan.neon       export-ignore
/tests              export-ignore

# Normalise line endings, so a checkout on Windows doesn't rewrite the icons
# or the templates.
* text=auto eol=lf
*.svg   text eol=lf
*.js    text eol=lf
*.php   text eol=lf
*.twig  text eol=lf
