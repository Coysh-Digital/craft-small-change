{# Shown after payment at /donate/complete, and while a slow payment method is still processing. #}
{% extends '_small-change/layout' %}
{% set title = 'Thank you' %}
{% set order = craft.smallChange.recentOrder(craft.app.request.getQueryParam('number')) %}

{% block content %}
    {% if not order %}
        <h1>Thank you</h1>
        <p>We couldn't show your receipt here. If you donated, you'll find it in your email.</p>
    {% elseif order.state == 'completed' %}
        <h1>Thank you for your gift</h1>
        <p>We've received your {{ craft.smallChange.formatMoney(order.totalPaid, order.currency) }} donation. A receipt is on its way to {{ order.email }}.</p>
        <p>Reference: <strong>{{ order.number }}</strong></p>
        {% if order.giftAidDeclared %}
            <p>Thanks for choosing Gift Aid on {{ craft.smallChange.formatMoney(order.giftAidEligibleAmount, order.currency) }} of your gift.</p>
        {% endif %}
    {% elseif order.paymentStatus == 'processing' %}
        <h1>Your payment is processing</h1>
        <p>Some payment methods take a little while. We'll email {{ order.email }} as soon as it's confirmed.</p>
    {% else %}
        <h1>We haven't received your payment</h1>
        <p>You haven't been charged. <a href="/donate">Try again</a>.</p>
    {% endif %}
{% endblock %}
